PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/docflow_complete?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
OTP_SECRET=replace_with_a_different_long_random_secret
ADMIN_EMAIL=admin@docflow.com
ADMIN_PASSWORD=Admin123
SEED_SAMPLE_USERS=true
SAMPLE_DOCTOR_PASSWORD=Doctor123

# Registration OTP email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=DocFlow <no-reply@example.com>

# Optional: enables a live SMTP handoff during `npm run qa`
QA_EMAIL_RECIPIENT=

# SSLCommerz hosted checkout. Sandbox credentials come from
# https://developer.sslcommerz.com/ ("Sandbox" store). When these are set they take
# priority over Stripe. Set SSLCOMMERZ_SANDBOX=false only for a live merchant account.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Stripe Checkout and signed webhook delivery (fallback when SSLCommerz is unset)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYMENT_CURRENCY=bdt
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Public base URL of THIS API. SSLCommerz posts its payment result here, so in
# production it must be an internet-reachable HTTPS origin, not localhost.
SERVER_PUBLIC_URL=http://localhost:5000

# Runtime protection and monitoring
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
SHUTDOWN_TIMEOUT_MS=10000
METRICS_TOKEN=replace_with_a_long_random_monitoring_token
BACKUP_RETENTION_DAYS=35

# Twilio SMS reminders (use either FROM_NUMBER or MESSAGING_SERVICE_SID)
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_FROM_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=

# Care assistant. Runs a local Ollama model so patient symptom text never leaves
# the host. Install from https://ollama.com then: ollama pull llama3.2:3b
# If Ollama is unreachable the assistant falls back to keyword routing.
AI_ASSISTANT=true
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=45000
AI_LOOKAHEAD_DAYS=7
